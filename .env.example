# Copia este archivo como .env y ajusta los valores:  cp .env.example .env
# El archivo .env está excluido del repositorio: nunca subas credenciales reales.
# Con estos valores el proyecto funciona en local, sin servicios externos.

# --- Aplicación ---
# "desarrollo" muestra el código de verificación sin enviar correo. Por defecto: produccion
AGROCOLAB_MOD_MODE=desarrollo
# Clave para firmar los tokens (32 caracteres o más; la de ejemplo se rechaza). Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
AGROCOLAB_SECRET=cambia-esta-clave-por-una-generada

# --- Base de datos ---
# Vacía: usa SQLite local (backend/agrocolab.db). En producción, la conexión a PostgreSQL:
# DATABASE_URL=postgresql://usuario:clave@servidor:5432/agrocolab
DATABASE_URL=
# Tiene prioridad sobre DATABASE_URL. La usan las pruebas para una base temporal
# AGROCOLAB_DB_URL=sqlite:///./temporal.db
# Base PostgreSQL opcional para correr las pruebas
# PRUEBAS_DB_URL=postgresql://agrocolab:agrocolab@localhost:5432/agrocolab_pruebas

# --- Correo (Brevo). Obligatorias para registrar cuentas en producción ---
# BREVO_API_KEY=xkeysib-ejemplo
# CORREO_REMITENTE=hola@ejemplo.cl

# --- Cuenta de administrador. La contraseña exige 12 caracteres o más ---
# ADMIN_EMAIL=admin@ejemplo.cl
# ADMIN_PASSWORD=una-clave-larga-de-ejemplo
# ADMIN_NOMBRE=Administrador

# --- Monitoreo de seguridad ---
# Token del panel, de 24 caracteres o más. Sin él, el panel queda desactivado
# MONITOREO_TOKEN=token-de-ejemplo-de-24-caracteres-o-mas
# ALERTA_CORREO=seguridad@ejemplo.cl
# ALERTA_WEBHOOK_URL=https://discord.com/api/webhooks/ejemplo
