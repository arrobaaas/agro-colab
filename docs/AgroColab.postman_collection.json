{
  "info": {
    "name": "Agro-Colab API (Hito 2)",
    "description": "Peticiones de la demostración en vivo. Ejecutar en orden, con el servicio corriendo y una base recién creada. Las pruebas de cada petición verifican el código de estado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "pagoId",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Preparación",
      "item": [
        {
          "name": "Ver que el servicio responde",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/estado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "estado"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión como comprador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"comprador@agrocolab.cl\",\n  \"password\": \"123\",\n  \"rol\": \"comprador\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", cuerpo.user.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar el catálogo de árboles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/arboles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "arboles"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pagar el plan de abastecimiento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pagos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pagos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"plan\",\n  \"plan_nombre\": \"Canasta Huerto Esencial\",\n  \"numero\": \"4242 4242 4242 4242\",\n  \"titular\": \"Camila Soto\",\n  \"vencimiento\": \"12/30\",\n  \"cvv\": \"123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const cuerpo = pm.response.json();",
                  "pm.collectionVariables.set(\"pagoId\", cuerpo.pago.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Crear, leer, actualizar y borrar un pedido",
