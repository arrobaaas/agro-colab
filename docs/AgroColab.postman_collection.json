            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan_nombre\": \"Canasta Huerto Esencial\",\n  \"cliente_nombre\": \"Camila Soto\",\n  \"telefono\": \"+56911111111\",\n  \"email\": \"comprador@agrocolab.cl\",\n  \"tipo_destino\": \"particular\",\n  \"direccion\": \"Av. Falsa 123\",\n  \"comuna\": \"Ñuñoa\",\n  \"frecuencia_entrega\": \"mensual\",\n  \"pago_id\": {{pagoId}}\n}",
